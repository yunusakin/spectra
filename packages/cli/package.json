{
  "name": "spectra-pack",
  "version": "3.1.3",
  "description": "Persistent, governed project intelligence for coding agents: context, rules, traceability, verification and change impact",
  "license": "MIT",
  "author": "Yunus Akin",
  "type": "module",
  "bin": {
    "spectra": "bin/spectra.js"
  },
  "scripts": {
    "build:native": "node ./scripts/check-versions.mjs && node ./scripts/build-native.mjs",
    "prepack": "node ./scripts/check-versions.mjs && node ./scripts/sync-assets.mjs",
    "pretest": "node ./scripts/sync-assets.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "test:approval": "node --test test/approval.test.js",
    "test:context": "node --test test/context-selection.test.js",
    "test:install-layout": "node --test test/install-layout.test.js",
    "test:installer": "node --test test/native-installation-e2e.test.js",
    "test:knowledge": "node --test test/knowledge-map.test.js test/knowledge-addressing.test.js test/context-knowledge.test.js",
    "test:lifecycle": "node --test test/lifecycle-e2e.test.js",
    "test:migration": "node --test test/migration.test.js test/migration-e2e.test.js test/update.test.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "evals",
    "governance",
    "product-development",
    "release-confidence",
    "spectra",
    "spec-driven",
    "telemetry",
    "verification"
  ],
  "homepage": "https://github.com/yunusakin/spectra#readme",
  "bugs": {
    "url": "https://github.com/yunusakin/spectra/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunusakin/spectra.git"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
