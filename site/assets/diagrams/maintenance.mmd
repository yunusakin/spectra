  classDef result fill:#effcf8,stroke:#007f68,color:#121827,stroke-width:1.5px;
  classDef condition fill:#fff9ea,stroke:#8a5d00,color:#121827,stroke-width:1.5px;
  classDef neutral fill:#f2f8ff,stroke:#64748b,color:#121827;
  class UPDATE,UNINSTALL,CHECK,APPLY,DOCTOR,FIX,ADAPTERS command;
  class NATIVE,OTHER,ADAPTER_REPAIR,MANUAL result;
  class SAFE,HEALTHY condition;
  class NOTE,KEEP neutral;
